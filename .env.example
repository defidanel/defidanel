# Copy to .env.local for local development (git-ignored by *.local).
# All keys are optional — the app runs without them and the live buttons
# degrade to a clear "not configured" message.

# Enables "Fetch live prices" (PriceCharting index) on the Pricing page.
# Get a token from PriceCharting's API program: https://www.pricecharting.com/api-documentation
PRICECHARTING_API_KEY=

# Enables "Fetch active eBay supply" (live active listings / asking prices).
# Create an app at https://developer.ebay.com/ and use the PRODUCTION
# App ID (Client ID) + Cert ID (Client Secret). The proxy uses the
# client-credentials OAuth flow — no user login required.
# NOTE: this reads ACTIVE listings only. eBay's sold-comp API
# (Marketplace Insights) is a closed partner-only program.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Enables the Arb Scanner's "Fetch listings" (tokenized-card marketplace).
# api/collectorcrypt.js is a SCAFFOLD — set the real base URL and confirm the
# listings path/auth from https://docs.collectorcrypt.com/marketplace/api.
# The scanner's math works without this (manual token-price + comp inputs);
# these only power the optional live-listings fetch.
COLLECTORCRYPT_API_BASE=
COLLECTORCRYPT_API_KEY=
